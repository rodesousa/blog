{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/posts", "destination": "/", "permanent": true },
    { "source": "/posts/", "destination": "/", "permanent": true },
    { "source": "/en/posts", "destination": "/en", "permanent": true },
    { "source": "/en/posts/", "destination": "/en", "permanent": true }
  ]
}
